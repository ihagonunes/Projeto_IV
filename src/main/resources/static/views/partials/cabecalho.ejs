<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>
    <%= ((typeof titulo==="undefined" || !titulo) ? "ATLAS" : (titulo + " - ATLAS" )) %>
</title>

<!-- Slug do tenant para o frontend (login/API /api/v1). Configurado via BFF/env. -->
<script>
    window.QSOFT_TENANT_SLUG = '<%= typeof qsoftTenantSlug !== "undefined" ? qsoftTenantSlug : "" %>';
</script>

<!-- Bootstrap CSS (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

<!-- Bootstrap Icons (CDN) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- Google Fonts: Poppins (UI) + Cinzel Decorative (logo/branding grego) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">

<!-- Base CSS Variables and Overrides -->
<link href="/public/css/base/variables.css" rel="stylesheet">
<link href="/public/css/base/display-scale.css?v=1" rel="stylesheet">
<link href="/public/css/base/bootstrap-overrides.css" rel="stylesheet">
<link href="/public/css/components/buttons.css" rel="stylesheet">
<link href="/public/css/components/form-fields.css" rel="stylesheet">
