<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/components/wizard-tabs.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-4">

        <div class="onboarding-card p-5 bg-white">
            
            <!-- Menu de Passos (Stepper) -->
            <ul class="wizard-stepper">
                <li class="wizard-step">
                    Tenant
                </li>
                <li class="wizard-step">
                    Administrador Principal
                </li>
                <li class="wizard-step">
                    Departamentos
                </li>
                <li class="wizard-step">
                    Usuários
                </li>
                <li class="wizard-step active">
                    IA
                </li>
                <li class="wizard-step">
                    Revisão
                </li>
            </ul>

            <form id="iaForm" action="/onboarding/steps/step-revisao" method="GET" novalidate>
                
                <!-- Credencial do Provedor de IA (BYOK) -->
                <div class="mb-4">
                    <h5 class="fw-semibold text-dark mb-3">Credencial do Provedor de IA (BYOK)</h5>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label for="provedorIa" class="form-label-custom">Provedor de IA</label>
                            <select class="form-select custom-input" id="provedorIa">
                                <option value="" disabled selected>Selecione...</option>
                                <option value="openai">OpenAI</option>
                                <option value="anthropic">Anthropic</option>
                                <option value="google">Google Gemini</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label for="apiKey" class="form-label-custom">Chave de API</label>
                            <input type="password" class="form-control custom-input" id="apiKey" placeholder="sk-...">
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-orange btn-pill w-100 py-2 fw-bold">testar conexão</button>
                        </div>
                        
                        <div class="col-md-10">
                            <label for="nomeCredencial" class="form-label-custom">Nome interno da credencial</label>
                            <input type="text" class="form-control custom-input" id="nomeCredencial" placeholder="Ex: Credencial Produção">
                        </div>
                    </div>
                </div>

                <!-- Catálogo de Modelos -->
                <div class="mb-4">
                    <h5 class="fw-semibold text-dark mb-3">Catálogo de Modelos</h5>
                    <div class="data-grid-container">
                        <table class="data-grid">
                            <thead>
                                <tr>
                                    <th>Nome do modelo</th>
                                    <th>Status</th>
                                    <th>Permissões</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>gpt-4o</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="model1" checked>
                                            <label class="form-check-label" for="model1">Ativo</label>
                                        </div>
                                    </td>
                                    <td>
                                        <select class="form-select custom-input form-select-sm w-auto">
                                            <option value="todos">Todos  </option>
                                            <option value="restrito">Restrito  </option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td>claude-3-5-sonnet</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="model2">
                                            <label class="form-check-label" for="model2">Inativo</label>
                                        </div>
                                    </td>
                                    <td>
                                        <select class="form-select custom-input form-select-sm w-auto">
                                            <option value="todos">Todos</option>
                                            <option value="restrito">Restrito</option>
                                        </select>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Botões de Ação -->
                <div class="d-flex justify-content-between mt-4">
                    <a href="/onboarding/steps/step-usuarios-hub" class="btn btn-outline-secondary btn-pill">voltar</a>
                    <button type="submit" class="btn btn-orange btn-pill text-white fw-bold">próximo</button>
                </div>
            </form>

        </div>

    </div>

    <!-- Bootstrap JS -->

<!-- Scripts específicos do passo -->
<script src="/public/js/pages/onboarding/step-ia.js"></script>
