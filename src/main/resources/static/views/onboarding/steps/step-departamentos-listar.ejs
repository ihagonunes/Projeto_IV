<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/components/wizard-tabs.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-4">

        <div class="onboarding-card p-5 bg-white">
            
            <!-- Menu de Passos (Stepper) -->
            <ul class="wizard-stepper">
                <li class="wizard-step">
                    Tenant
                </li>
                <li class="wizard-step">
                    Administrador Principal
                </li>
                <li class="wizard-step active">
                    Departamentos
                </li>
                <li class="wizard-step">
                    Usuários
                </li>
                <li class="wizard-step">
                    IA
                </li>
                <li class="wizard-step">
                    Revisão
                </li>
            </ul>

            <div class="my-4">
                <h4 class="mb-3 text-dark fw-semibold">Departamentos Cadastrados</h4>
                <div class="data-grid-container">
                    <table class="data-grid">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>Líder</th>
                                <th>Orçamento</th>
                                <th>Alerta</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td contenteditable="true">Tecnologia da Informação</td>
                                <td contenteditable="true">João Silva</td>
                                <td contenteditable="true">R$ 50.000,00</td>
                                <td contenteditable="true">80%</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1 btn-pill">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger btn-pill">Excluir</button>
                                </td>
                            </tr>
                            <tr>
                                <td contenteditable="true">Recursos Humanos</td>
                                <td contenteditable="true">Maria Oliveira</td>
                                <td contenteditable="true">R$ 15.000,00</td>
                                <td contenteditable="true">90%</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary me-1 btn-pill">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger btn-pill">Excluir</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Botões de Ação -->
            <div class="d-flex justify-content-between mt-4">
                <a href="/onboarding/steps/step-departamentos-hub" class="btn btn-outline-secondary btn-pill">voltar</a>
                <a href="/onboarding/steps/step-usuarios-hub" class="btn btn-orange btn-pill text-white fw-bold">próximo</a>
            </div>

        </div>

    </div>

    <!-- Bootstrap JS -->

<!-- Scripts específicos do passo -->
<script src="/public/js/pages/onboarding/step-departamentos.js"></script>
