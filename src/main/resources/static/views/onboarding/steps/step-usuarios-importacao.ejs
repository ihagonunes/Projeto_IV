<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/components/wizard-tabs.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-4">

        <div class="onboarding-card p-5 bg-white">
            
            <!-- Menu de Passos (Stepper) -->
            <ul class="wizard-stepper">
                <li class="wizard-step">
                    Tenant
                </li>
                <li class="wizard-step">
                    Administrador Principal
                </li>
                <li class="wizard-step">
                    Departamentos
                </li>
                <li class="wizard-step active">
                    Usuários
                </li>
                <li class="wizard-step">
                    IA
                </li>
                <li class="wizard-step">
                    Revisão
                </li>
            </ul>

            <form id="importForm" action="/onboarding/steps/step-usuarios-hub" method="GET" novalidate>
                <div class="my-4 text-center">
                    <h4 class="mb-3 text-dark fw-semibold">Importação de Usuários</h4>
                    <p class="text-muted">Faça o upload da planilha contendo a lista de usuários da plataforma.</p>
                    
                    <div class="upload-zone mx-auto" style="max-width: 500px; min-height: 200px;">
                        <input type="file" id="userFile" class="d-none" accept=".csv, .xlsx, .xls">
                        <label for="userFile" class="btn btn-outline-secondary btn-pill cursor-pointer px-4 py-2">Selecionar Planilha</label>
                        <span class="text-muted small mt-3 d-block">Formatos suportados: .csv, .xlsx, .xls</span>
                    </div>
                </div>

                <!-- Botões de Ação -->
                <div class="d-flex justify-content-between mt-5">
                    <a href="/onboarding/steps/step-usuarios-hub" class="btn btn-outline-secondary btn-pill">voltar</a>
                    <button type="submit" class="btn btn-orange btn-pill text-white fw-bold">próximo</button>
                </div>
            </form>

        </div>

    </div>

    <!-- Bootstrap JS -->

<!-- Scripts específicos do passo -->
<script src="/public/js/pages/onboarding/step-usuarios.js"></script>
