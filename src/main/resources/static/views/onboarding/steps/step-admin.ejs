<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/components/wizard-tabs.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-4">

        <div class="onboarding-card p-5 bg-white">
            
            <!-- Menu de Passos (Stepper) -->
            <ul class="wizard-stepper">
                <li class="wizard-step">
                    Tenant
                </li>
                <li class="wizard-step active">
                    Administrador Principal
                </li>
                <li class="wizard-step">
                    Departamentos
                </li>
                <li class="wizard-step">
                    Usuários
                </li>
                <li class="wizard-step">
                    IA
                </li>
                <li class="wizard-step">
                    Revisão
                </li>
            </ul>

            <form id="adminForm" action="/onboarding/steps/step-departamentos-hub" method="GET" novalidate>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="nomeCompleto" class="form-label-custom">Nome completo *</label>
                        <input type="text" class="form-control custom-input" id="nomeCompleto" required>
                    </div>
                    <div class="col-md-6">
                        <label for="emailCorporativo" class="form-label-custom">E-mail corporativo *</label>
                        <input type="email" class="form-control custom-input" id="emailCorporativo" placeholder="exemplo@empresa.com" required>
                    </div>
                    
                    <div class="col-md-6">
                        <label for="cargo" class="form-label-custom">Cargo *</label>
                        <input type="text" class="form-control custom-input" id="cargo" required>
                    </div>
                    <div class="col-md-6">
                        <label for="telefone" class="form-label-custom">Telefone de contato *</label>
                        <input type="tel" class="form-control custom-input" id="telefone" placeholder="(00) 00000-0000" required>
                    </div>

                    <div class="col-md-6">
                        <label for="senha" class="form-label-custom">Senha *</label>
                        <input type="password" class="form-control custom-input" id="senha" required>
                    </div>
                    <div class="col-md-6">
                        <label for="confirmarSenha" class="form-label-custom">Confirmação de senha *</label>
                        <input type="password" class="form-control custom-input" id="confirmarSenha" required>
                    </div>
                </div>

                <!-- Botões de Ação -->
                <div class="d-flex justify-content-between mt-4">
                    <a href="/onboarding/steps/step-tenant" class="btn btn-outline-secondary btn-pill">voltar</a>
                    <button type="submit" class="btn btn-orange btn-pill text-white fw-bold">próximo</button>
                </div>
            </form>

        </div>

    </div>

    <!-- Bootstrap JS -->

<!-- Scripts específicos do passo -->
<script src="/public/js/pages/onboarding/step-admin.js"></script>
