<%- contentFor("espaco-head") %>
    <link href="/public/css/components/auth-card.css" rel="stylesheet">
    <link href="/public/css/pages/login.css" rel="stylesheet">

    <div class="container d-flex justify-content-center align-items-center vh-100">

        <div class="auth-card text-center p-1 bg-white">
            <div class="auth-card text-center p-1 bg-white">
                <div class="auth-card text-center p-1 bg-white">

                    <h1 class="mb-4 text-dark fw-light">Bem-Vindo</h1>

                    <form id="loginForm" action="#" method="POST" novalidate>

                        <!-- Campo E-mail -->
                        <div class="mb-3">
                            <input type="email" class="form-control custom-input" id="email" placeholder="e-mail"
                                required>
                            <div class="invalid-feedback text-center mt-2">
                                Ei, você esqueceu de preencher o e-mail!
                            </div>
                        </div>

                        <!-- Campo Senha -->
                        <div class="mb-3">
                            <input type="password" class="form-control custom-input" id="senha" placeholder="senha"
                                required>
                            <div class="invalid-feedback text-center mt-2">
                                Ei, você esqueceu de preencher a senha!
                            </div>
                        </div>

                        <!-- Link Esqueci a Senha -->
                        <div class="mb-4">
                            <a href="/redefinir-senha" id="btnEsqueciSenha"
                                class="text-muted text-decoration-none small">esqueci a
                                senha</a>
                        </div>

                        <!-- Botão de Entrar -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-orange btn-pill text-white fw-bold">entrar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

    </div>

    <!-- Scripts do Login -->
    <script src="/public/js/core/api-client.js"></script>
    <script src="/public/js/core/auth.js"></script>
    <script src="/public/js/pages/login.js"></script>