<%- contentFor("espaco-head") %>
<link href="/public/css/components/auth-card.css" rel="stylesheet">
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/pages/admin-usuarios.css" rel="stylesheet">

<div class="container py-5">

    <!-- Cabeçalho Administrativo e Contexto do Tenant -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">Editar Dados da Empresa</h1>
                <span class="tenant-context-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                        class="bi bi-building" viewBox="0 0 16 16">
                        <path
                            d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 8.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 11.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z" />
                        <path
                            d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1zm11 0H3v14h3v-2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V15h3z" />
                    </svg>
                    Tenant: <span id="tenantContextName">Minha Empresa</span>
                </span>
            </div>
            <p class="text-muted mb-0 small">Edição contínua das informações institucionais, localização e marca da empresa.</p>
        </div>

        <div class="admin-header-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                class="bi bi-gear-fill" viewBox="0 0 16 16">
                <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.93 2.93 0 1 1 0-5.86 2.93 2.93 0 0 1 0 5.86"/>
            </svg>
            <span>Configurações do Tenant</span>
        </div>
    </div>

    <!-- Área de Alertas e Notificações -->
    <div id="alertArea" class="mb-4"></div>

    <!-- Card Principal de Formulário -->
    <div class="admin-card p-4">
        <form id="editarEmpresaForm" novalidate>
            <div class="row g-4">

                <!-- Coluna da Esquerda: Formulário -->
                <div class="col-lg-8">
                    <p class="atlas-section-title">Identificação Institucional</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="nomeEmpresa" class="form-label-custom">Nome da empresa *</label>
                            <input type="text" class="form-control custom-input" id="nomeEmpresa" required placeholder="Ex: Acceletec Solutions">
                            <div class="invalid-feedback">Informe o nome da empresa.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="cnpj" class="form-label-custom">CNPJ *</label>
                            <input type="text" class="form-control custom-input" id="cnpj" placeholder="00.000.000/0000-00" required>
                            <div class="invalid-feedback">Informe um CNPJ válido.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="setor" class="form-label-custom">Setor de Atuação *</label>
                            <select class="form-select custom-input" id="setor" required>
                                <option value="" disabled selected>Selecione...</option>
                                <option value="tecnologia">Tecnologia</option>
                                <option value="saude">Saúde</option>
                                <option value="educacao">Educação</option>
                                <option value="financas">Finanças</option>
                                <option value="outro">Outro</option>
                            </select>
                            <div class="invalid-feedback">Selecione o setor de atuação.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="porteEmpresa" class="form-label-custom">Porte da Empresa *</label>
                            <select class="form-select custom-input" id="porteEmpresa" required>
                                <option value="" disabled selected>Selecione...</option>
                                <option value="micro">Microempresa</option>
                                <option value="pequena">Pequena Empresa</option>
                                <option value="media">Média Empresa</option>
                                <option value="grande">Grande Empresa</option>
                            </select>
                            <div class="invalid-feedback">Selecione o porte da empresa.</div>
                        </div>

                        <p class="atlas-section-title mt-4">Localização & Preferências do Sistema</p>

                        <div class="col-md-6">
                            <label for="fusoHorario" class="form-label-custom">Fuso Horário Padrão *</label>
                            <select class="form-select custom-input" id="fusoHorario" required>
                                <option value="GMT-3">Brasília (GMT-3)</option>
                                <option value="GMT-4">Manaus (GMT-4)</option>
                                <option value="GMT-5">Rio Branco (GMT-5)</option>
                                <option value="UTC">UTC</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="idioma" class="form-label-custom">Idioma Padrão *</label>
                            <select class="form-select custom-input" id="idioma" required>
                                <option value="pt-BR">Português (Brasil)</option>
                                <option value="en">Inglês</option>
                                <option value="es">Espanhol</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Coluna da Direita: Logotipo -->
                <div class="col-lg-4 d-flex flex-column">
                    <p class="atlas-section-title">Logotipo da Empresa</p>
                    <div class="upload-zone d-flex flex-column align-items-center justify-content-center p-4"
                        style="flex: 1; min-height: 220px; border: 2px dashed rgba(240, 194, 47, 0.3); border-radius: 12px; background: rgba(11, 16, 32, 0.4);">
                        <div id="logoPreviewContainer" class="mb-3 text-center d-none">
                            <img id="logoPreviewImg" src="" alt="Preview Logo" style="max-height: 80px; max-width: 100%; object-fit: contain;">
                        </div>
                        <i id="uploadIcon" class="bi bi-cloud-upload" style="font-size: 2.5rem; color: var(--color-primary); opacity: 0.7;"></i>
                        <input type="file" id="logoEmpresa" class="d-none" accept="image/*">
                        <label for="logoEmpresa" class="btn btn-outline-secondary btn-pill mt-3 px-4" style="cursor: pointer;">
                            Alterar logotipo
                        </label>
                        <span class="text-center mt-2" style="font-size: 0.75rem; color: var(--text-color-muted);">
                            PNG, JPG ou SVG · Máx 2MB
                        </span>
                    </div>
                </div>

            </div>

            <!-- Rodapé com Ações -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a href="/onboarding" class="text-decoration-none text-muted small">← Voltar para o Onboarding</a>
                <button type="submit" id="btnSalvar" class="btn btn-orange btn-pill fw-bold px-4 d-flex align-items-center gap-2">
                    <span id="salvarSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span>Salvar Alterações</span>
                </button>
            </div>
        </form>
    </div>

</div>

<!-- Scripts -->
<script src="/public/js/core/api-client.js"></script>
<script src="/public/js/pages/editar-empresa.js"></script>
