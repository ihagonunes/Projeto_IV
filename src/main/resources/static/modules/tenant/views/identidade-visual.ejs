<%- contentFor("espaco-head") %>
<link href="/public/css/components/auth-card.css" rel="stylesheet">
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/pages/admin-usuarios.css" rel="stylesheet">

<style>
/* Estilos específicos do Live Preview de Cabeçalho */
.header-preview-card {
    background: rgba(16, 24, 45, 0.9);
    border: 1px solid rgba(240, 194, 47, 0.25);
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.navbar-mockup {
    background: #0B1020;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.6);
}

.navbar-mockup-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.navbar-mockup-logo-img {
    height: 32px;
    max-width: 120px;
    object-fit: contain;
}

.navbar-mockup-brand-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #F0C22F;
    letter-spacing: 1px;
}

.navbar-mockup-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.navbar-mockup-item {
    font-size: 0.75rem;
    color: rgba(139, 142, 161, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.navbar-mockup-item.active {
    color: #F0C22F;
    font-weight: 600;
}

.navbar-mockup-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #0B1020;
    font-weight: 700;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>

<div class="container py-5">

    <!-- Cabeçalho Administrativo e Contexto do Tenant -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0">Identidade Visual & Branding</h1>
                <span class="tenant-context-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                        class="bi bi-building" viewBox="0 0 16 16">
                        <path
                            d="M4 2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 5.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 8.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zM4 11.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm3.5-.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z" />
                        <path
                            d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1zm11 0H3v14h3v-2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5V15h3z" />
                    </svg>
                    Tenant: <span id="tenantContextName">Minha Empresa</span>
                </span>
            </div>
            <p class="text-muted mb-0 small">Personalize a marca e a apresentação do logotipo oficial nos cabeçalhos da plataforma.</p>
        </div>

        <div class="admin-header-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                class="bi bi-palette-fill" viewBox="0 0 16 16">
                <path d="M12.438 1.578a7 7 0 0 0-9.9 9.9 7 7 0 0 0 9.9-9.9zM12.5 14a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/>
                <path d="M2.3 12.7c.3.3.8.3 1.1 0l3-3c.3-.3.3-.8 0-1.1s-.8-.3-1.1 0l-3 3c-.3.3-.3.8 0 1.1z"/>
            </svg>
            <span>Configuração White-Label</span>
        </div>
    </div>

    <!-- Área de Alertas e Notificações -->
    <div id="alertArea" class="mb-4"></div>

    <!-- Container Form + Live Preview -->
    <div class="row g-4">

        <!-- Coluna da Esquerda: Formulário de Configuração -->
        <div class="col-lg-6">
            <div class="admin-card p-4 h-100">
                <h2 class="h5 fw-bold mb-3">Marca & Logotipo Corporativo</h2>
                <form id="identidadeForm" novalidate>

                    <!-- Nome da Marca / Exibição -->
                    <div class="mb-4">
                        <label for="nomeExibicao" class="form-label-custom fw-semibold">Nome de Exibição da Marca *</label>
                        <input type="text" class="form-control custom-input" id="nomeExibicao" readonly
                            placeholder="Ex: Acceletec Solutions">
                        <div class="field-explanation mt-1">Este nome será exibido ao lado da logo ou como texto principal no cabeçalho.</div>
                    </div>

                    <!-- Referência do logotipo persistida pela API de branding -->
                    <div class="mb-4">
                        <label class="form-label-custom fw-semibold">Logotipo Principal</label>
                        <div class="upload-zone d-flex flex-column align-items-center justify-content-center p-4"
                            style="border: 2px dashed rgba(240, 194, 47, 0.3); border-radius: 12px; background: rgba(11, 16, 32, 0.4);">
                            
                            <div id="logoPreviewThumbContainer" class="mb-3 text-center d-none">
                                <img id="logoPreviewThumb" src="" alt="Thumbnail Logo"
                                    style="max-height: 65px; max-width: 100%; object-fit: contain;">
                            </div>

                            <i id="uploadIcon" class="bi bi-cloud-upload" style="font-size: 2.2rem; color: var(--color-primary); opacity: 0.75;"></i>
                            <label for="logoUrl" class="form-label mt-3">URL da imagem</label>
                            <input type="url" id="logoUrl" class="form-control custom-input" maxlength="500" placeholder="https://exemplo.com/logo.png">
                            <span class="text-center mt-2" style="font-size: 0.75rem; color: var(--text-color-muted);">
                                Informe o endereço público da imagem. Deixe vazio para remover o logotipo.
                            </span>
                        </div>
                    </div>

                    <!-- Botão Salvar -->
                    <div class="pt-3 border-top d-flex justify-content-end">
                        <button type="submit" id="btnSalvarIdentidade" class="btn btn-orange btn-pill fw-bold px-4 d-flex align-items-center gap-2">
                            <span id="salvarSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span>Salvar Identidade Visual</span>
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Coluna da Direita: Live Preview do Cabeçalho -->
        <div class="col-lg-6">
            <div class="header-preview-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-eye-fill text-warning"></i>
                            Live Preview do Cabeçalho
                        </h2>
                        <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size: 0.65rem;">TEMPO REAL</span>
                    </div>
                    <p class="text-muted small mb-4">
                        Veja em tempo real como o cabeçalho superior da plataforma ATLAS se apresentará para os colaboradores da empresa.
                    </p>

                    <!-- Mockup da Barra Superior de Navegação -->
                    <div class="navbar-mockup mb-4">
                        <div class="navbar-mockup-brand">
                            <img id="previewNavbarLogo" src="" alt="Logo Preview" class="navbar-mockup-logo-img d-none">
                            <span id="previewNavbarBrand" class="navbar-mockup-brand-text">ACCELETEC</span>
                        </div>
                        <div class="navbar-mockup-nav">
                            <span class="navbar-mockup-item active">Dashboard</span>
                            <span class="navbar-mockup-item d-none d-sm-inline">Revisão</span>
                            <span class="navbar-mockup-item d-none d-md-inline">Usuários</span>
                            <div class="navbar-mockup-avatar" title="Usuário Autenticado">
                                AC
                            </div>
                        </div>
                    </div>

                    <!-- Card Informativo -->
                    <div class="p-3 rounded-3" style="background: rgba(240, 194, 47, 0.06); border: 1px solid rgba(240, 194, 47, 0.15);">
                        <div class="d-flex gap-2 align-items-start">
                            <i class="bi bi-info-circle-fill text-warning fs-6 flex-shrink-0 mt-1"></i>
                            <div class="small text-muted" style="line-height: 1.45;">
                                <strong class="text-light d-block mb-1">Padronização de Layout Preservada</strong>
                                O logo corporativo será ajustado automaticamente para manter a proporção ideal no cabeçalho sem afetar o contraste e a usabilidade do tema ATLAS.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top text-center">
                    <a href="/onboarding" class="text-decoration-none text-muted small">← Voltar para o Onboarding</a>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- Scripts -->
<script src="/public/js/core/api-client.js?v=cookie-session-20261022"></script>
<script src="/public/js/pages/identidade-visual.js?v=admin-branding-20261023"></script>
