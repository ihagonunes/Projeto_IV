<%- contentFor("espaco-head") %>
<link rel="stylesheet" href="/public/css/pages/chat.css?v=spi-136-escape-selection">
<link rel="stylesheet" href="/public/css/pages/agent-plaza.css?v=spi-180-flow-studio-4">
<%- contentFor("body") %>
<a class="chat-skip" href="#chat-input">Pular para a mensagem</a>
<div id="chat-app" class="chat-shell" data-preview="<%= preview %>">
    <aside class="chat-sidebar" id="chat-sidebar" aria-label="Conversas">
        <a class="chat-brand" href="/onboarding"><img src="/public/img/atlas-name.png" alt="ATLAS"><span>SEU WORKSPACE DE IA</span></a>
        <button class="chat-new" id="chat-new"><i class="bi bi-plus-lg" aria-hidden="true"></i> Novo chat <span>↗</span></button>
        <label class="chat-search"><i class="bi bi-search" aria-hidden="true"></i><input id="chat-search" type="search" maxlength="100" placeholder="Buscar conversas" aria-label="Buscar conversas"></label>
        <div class="chat-history-tabs" role="group" aria-label="Filtrar histórico"><button id="chat-active" class="is-active" aria-pressed="true">Recentes</button><button id="chat-archived" aria-pressed="false">Arquivadas</button></div>
        <div class="chat-history" id="chat-history" aria-label="Histórico de conversas"></div>
        <button class="chat-text-button" id="chat-more" hidden>Carregar mais conversas</button>
        <div class="chat-sidebar-bottom">
            <div class="chat-private"><i class="bi bi-shield-lock" aria-hidden="true"></i><div><strong>Um espaço só seu</strong><span>Suas conversas são privadas.</span></div></div>
            <a class="chat-nav-link" href="/dashboard"><i class="bi bi-grid" aria-hidden="true"></i> Voltar ao dashboard <span>↗</span></a>
            <div class="chat-workspace">
                <% if (!preview && typeof demoProfilesEnabled !== 'undefined' && demoProfilesEnabled) { %>
                <%- include('../../../views/partials/demo-profiles') %>
                <% } else { %>
                <span class="chat-avatar">A</span><div><strong>Workspace ATLAS</strong><small><%= preview ? 'Prévia · dados fictícios' : 'Sessão corporativa' %></small></div>
                <% } %>
                <button class="chat-icon" id="chat-help" aria-label="Sobre este chat"><i class="bi bi-info-circle" aria-hidden="true"></i></button>
            </div>
        </div>
    </aside>
    <button id="chat-overlay" class="chat-overlay" aria-label="Fechar menu de conversas" hidden></button>
    <main class="chat-main" id="chat-main">
        <header class="chat-header">
            <div class="chat-header-left"><button id="chat-toggle" class="chat-icon" aria-label="Abrir ou recolher conversas" aria-controls="chat-sidebar" aria-expanded="true"><i class="bi bi-layout-sidebar" aria-hidden="true"></i></button><span class="chat-header-divider"></span><span class="chat-product">Chat de IA</span><span class="chat-beta">WORKSPACE</span></div>
            <div class="chat-header-right"><span class="chat-secure"><span></span> Ambiente corporativo</span><button id="chat-usage" class="chat-usage-button"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Consumo <span id="chat-usage-dot" hidden>●</span></button></div>
        </header>
        <% if (preview) { %><div class="chat-preview-banner"><span><i class="bi bi-stars" aria-hidden="true"></i> Prévia interativa · conversas, modelos e consumo fictícios</span><button id="chat-reset" class="chat-text-button">Restaurar prévia</button></div><% } %>
        <div class="chat-status" id="chat-status" role="status" aria-live="polite" hidden></div>
        <div class="chat-scroll" id="chat-scroll">
            <section class="chat-welcome" id="chat-welcome">
                <div class="chat-welcome-mark"><img src="/public/img/atlas-logo.png" alt=""></div>
                <p class="chat-eyebrow">MAIS CLAREZA. NOVAS POSSIBILIDADES.</p>
                <h1>O que vamos criar hoje?</h1>
                <p class="chat-welcome-description">Transforme ideias em próximos passos.<br>Seu assistente de IA, conectado ao seu trabalho.</p>
                <div class="chat-suggestions">
                    <button data-prompt="Me ajude a estruturar um plano de projeto com objetivos, etapas e entregáveis."><i class="bi bi-lightbulb" aria-hidden="true"></i><strong>Tirar uma ideia do papel</strong><span>Estruture um plano para começar</span><b>↗</b></button>
                    <button data-prompt="Quero melhorar um texto. Vou colar o conteúdo na próxima mensagem para você revisar clareza e tom."><i class="bi bi-pencil-square" aria-hidden="true"></i><strong>Encontrar as palavras certas</strong><span>Revise, escreva e comunique melhor</span><b>↗</b></button>
                    <button data-prompt="Me ajude a analisar um problema. Primeiro, me pergunte sobre o contexto e o objetivo."><i class="bi bi-bar-chart" aria-hidden="true"></i><strong>Explorar uma possibilidade</strong><span>Organize informações e perspectivas</span><b>↗</b></button>
                </div>
            </section>
            <section class="chat-thread" id="chat-thread" aria-label="Mensagens da conversa" hidden></section>
        </div>
        <button id="chat-scroll-bottom" class="chat-scroll-bottom chat-icon" aria-label="Ir para a última mensagem" hidden>↓</button>
        <div class="chat-composer-area">
            <div id="chat-token-warning" class="chat-token-warning" hidden></div>
            <div id="chat-flow-context" class="chat-flow-context" role="status" hidden></div>
            <form id="chat-form" class="chat-composer">
                <div id="chat-files" class="chat-files" hidden></div>
                <label for="chat-input" class="chat-visually-hidden">Sua mensagem</label>
                <textarea id="chat-input" rows="1" maxlength="8000" placeholder="Pergunte, explore ou comece uma ideia…"></textarea>
                <div class="chat-composer-toolbar">
                    <div class="chat-composer-tools"><button type="button" class="chat-icon" id="chat-attach" aria-label="Anexar arquivo"><i class="bi bi-plus-lg" aria-hidden="true"></i></button><span class="chat-tool-divider"></span><button type="button" id="chat-model" class="chat-model-button" aria-haspopup="dialog"><span class="chat-model-spark">✧</span><span id="chat-model-name">Padrão do departamento</span><i class="bi bi-chevron-down" aria-hidden="true"></i></button><button type="button" id="chat-agent" class="chat-model-button" aria-haspopup="dialog"><span>Agente</span><i class="bi bi-chevron-down" aria-hidden="true"></i></button></div>
                    <div class="chat-send-tools"><span id="chat-count">0 / 8.000</span><button id="chat-send" type="submit" class="chat-send" aria-label="Enviar mensagem" disabled>↑</button><button id="chat-stop" type="button" class="chat-send" aria-label="Parar espera pela resposta" hidden>■</button></div>
                </div>
            </form>
            <div class="chat-composer-footer"><span><i class="bi bi-lock" aria-hidden="true"></i> Privado por padrão</span><span>A IA pode cometer erros. Confira informações importantes.</span><button id="chat-context" class="chat-text-button">Contexto: últimas 20 mensagens</button></div>
        </div>
    </main>
    <aside class="chat-token-tank" aria-label="Consumo financeiro">
        <div class="chat-token-track" id="chat-token-tank" aria-hidden="true"><span></span></div>
        <div class="chat-token-caption">
            <span aria-hidden="true">Gasto</span>
            <output id="chat-token-total" aria-label="Valor gasto">—</output>
            <span id="chat-spending-limit" aria-label="Limite mensal"></span>
            <span id="chat-spending-percentage" aria-label="Percentual gasto"></span>
        </div>
    </aside>
</div>
<dialog id="chat-dialog" class="chat-dialog" aria-labelledby="chat-dialog-title"><div class="chat-dialog-heading"><h2 id="chat-dialog-title"></h2><button id="chat-dialog-close" class="chat-icon" aria-label="Fechar janela">×</button></div><div id="chat-dialog-body"></div></dialog>
<div id="chat-toast" class="chat-toast" role="status" aria-live="polite" hidden></div>
<% if (!preview) { %><script src="/public/js/core/api-client.js"></script><% } %>
<script src="/public/js/pages/chat-core.js?v=local-budget-001-final"></script>
<script src="/public/js/pages/agent-plaza.js?v=spi-180-flow-studio-4"></script>
<script src="/public/js/pages/agent-chat.js?v=spi-180-flow-studio-2"></script>
<script src="/public/js/pages/chat.js?v=spi-180-flow-studio-2"></script>
