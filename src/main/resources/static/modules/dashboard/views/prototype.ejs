<link rel="stylesheet" href="/public/css/pages/dashboards.css">
<%
const names = { colaborador: "Colaborador", lider: "Líder", gestor: "Gestor", executivo: "Executivo", agentes: "Análise de agentes", governanca: "Governança/TI" };
const isAgent = selection.profile === "agentes";
const number = value => value === null || value === undefined ? "—" : new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 1 }).format(value);
const money = value => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL", minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(value);
const date = value => new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", dateStyle: "short", timeStyle: "short" }).format(new Date(value));
%>
<a class="demo-skip" href="#dashboard-main">Pular para o conteúdo</a>
<div class="demo-shell">
    <aside class="demo-sidebar" aria-label="Navegação de desenvolvimento">
        <a href="/dashboards/colaborador" class="demo-brand atlas-brand">ATLAS<span>Governança de IA</span></a>
        <p class="demo-nav-label">DASHBOARDS · DEMONSTRAÇÃO</p>
        <nav aria-label="Dashboards">
            <% for (const [key, name] of Object.entries(names)) { %>
            <a href="/dashboards/<%= key %>" class="demo-nav-link <%= selection.profile === key ? 'active' : '' %>" <%- selection.profile === key ? 'aria-current="page"' : '' %>>
                <i class="bi <%= key === 'agentes' ? 'bi-cpu' : key === 'governanca' ? 'bi-shield-check' : 'bi-grid-1x2' %>" aria-hidden="true"></i><%= name %>
            </a>
            <% } %>
        </nav>
        <div class="demo-side-footer">
            <a href="/dashboard"><i class="bi bi-arrow-up-right" aria-hidden="true"></i> Dashboard integrado</a>
            <p>Prévia de desenvolvimento.<br>A troca de página não representa controle de acesso.</p>
        </div>
    </aside>
    <main id="dashboard-main" class="demo-main">
        <header class="demo-header">
            <div><p class="demo-eyebrow">WORKSPACE / <%= dashboard?.management ? 'ANÁLISE DEMONSTRATIVA' : isAgent ? 'AGENTES DE IA' : 'MEU CONSUMO' %></p>
                <h1><%= selection.profile === 'governanca' ? 'Dashboard de Governança/TI' : isAgent ? 'Análise de agentes' : 'Dashboard do ' + names[selection.profile] %></h1>
                <p class="demo-muted"><%= dashboard?.management ? 'Indicadores e controles ilustrativos, sem dados reais ou permissões nesta prévia.' : isAgent ? 'Acompanhe execuções, custos e desempenho por etapa.' : 'Uma visão clara do uso de inteligência artificial.' %></p>
            </div>
            <span class="demo-badge"><span aria-hidden="true">●</span> Dados simulados</span>
        </header>
        <div class="demo-notice"><i class="bi bi-info-circle" aria-hidden="true"></i> Ambiente de demonstração · referência: 09/10/2026 · horário de Brasília.</div>
        <form method="get" class="demo-filters" aria-label="Filtros do dashboard">
            <div><label for="periodo">Período de todos os gráficos</label>
                <select id="periodo" name="periodo" class="form-select custom-input">
                    <option value="semanal" <%= selection.period === 'semanal' ? 'selected' : '' %>>Semanal</option>
                    <option value="mensal" <%= selection.period === 'mensal' ? 'selected' : '' %>>Mensal</option>
                </select>
            </div>
            <% if (isAgent) { %>
            <div><label for="agente">Agente</label><select id="agente" name="agente" class="form-select custom-input">
                <option value="">Todos da amostra</option>
                <% for (const agent of (dashboard ? dashboard.agents : [{id: 'politicas-demo', name: 'Agente de Políticas'}, {id: 'orcamento-demo', name: 'Projeção orçamentária'}])) { %>
                <option value="<%= agent.id %>" <%= selection.agent === agent.id ? 'selected' : '' %>><%= agent.name %></option>
                <% } %>
            </select></div>
            <% } %>
            <div><label for="estado">Cenário de demonstração</label><select id="estado" name="estado" class="form-select custom-input">
                <% for (const [key, label] of [['normal', 'Com dados'], ['vazio', 'Sem dados'], ['erro', 'Erro da fonte']]) { %>
                <option value="<%= key %>" <%= selection.state === key ? 'selected' : '' %>><%= label %></option>
                <% } %>
            </select></div>
            <button type="submit" class="btn btn-orange">Aplicar filtros</button>
        </form>
        <% if (error) { %>
            <section class="demo-panel demo-state" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i><h2>Não foi possível carregar os indicadores</h2>
                <p>Este é um erro simulado para validar a apresentação. Nenhum dado real foi consultado.</p>
                <a class="btn btn-orange" href="?periodo=<%= selection.period %>&amp;estado=normal&amp;agente=<%= selection.agent %>">Tentar novamente</a>
            </section>
        <% } else if (dashboard.management) { %>
            <%- include('management', { dashboard }) %>
        <% } else if (dashboard.pending) { %>
            <section class="demo-panel demo-state"><i class="bi bi-sliders" aria-hidden="true"></i>
                <h2>Visibilidade em definição</h2>
                <p>Os indicadores e detalhamentos do perfil <%= names[selection.profile] %> serão apresentados após a definição de seu escopo.</p>
                <p class="demo-muted">Nenhuma permissão ou acesso a outros colaboradores foi presumido.</p>
            </section>
        <% } else { const data = dashboard.data; const k = data.kpis; %>
            <div class="demo-period"><span><%= dashboard.period.label %></span><span>America/Sao_Paulo</span></div>
            <% if (dashboard.state === 'vazio') { %>
            <div class="demo-notice" role="status">Nenhum registro para os filtros selecionados. Selecione “Com dados” para explorar a amostra.</div>
            <% } %>
            <section class="demo-kpis" aria-label="Indicadores">
                <% if (isAgent) { %>
                <article class="demo-panel demo-kpi"><span>Latência média</span><strong><%= number(k.latencyMeanMs) %> <small>ms</small></strong><p>p50 <%= number(k.p50Ms) %> ms <span>·</span> p95 <%= number(k.p95Ms) %> ms</p></article>
                <article class="demo-panel demo-kpi"><span>Execuções no período</span><strong><%= number(k.total) %></strong><p>Todos os status da amostra</p></article>
                <article class="demo-panel demo-kpi"><span>Custo acumulado do dia</span><strong><%= money(k.dailyCostBrl) %></strong><p>09/10/2026 · não é o total do período</p></article>
                <article class="demo-panel demo-kpi"><span>Taxa de sucesso</span><strong><%= number(k.successPercent) %><small> %</small></strong><p>Execuções COMPLETED no período</p></article>
                <% } else { %>
                <article class="demo-panel demo-kpi"><span>Meu consumo de tokens</span><strong><%= number(k.totalTokens) %></strong><p>Entrada <%= number(k.inputTokens) %> · saída <%= number(k.outputTokens) %></p></article>
                <article class="demo-panel demo-kpi"><span>Minha posição em AI Credits</span><strong><%= k.rank === null ? '—' : k.rank + 'º' %></strong><p>Somente a sua posição é apresentada</p></article>
                <article class="demo-panel demo-kpi"><span>Meus AI Credits</span><strong><%= number(k.credits) %></strong><p>Acumulado do período · simulado</p></article>
                <article class="demo-panel demo-kpi"><span>Média de tokens por colaborador</span><strong><%= number(k.averageTokens) %></strong><p>Agregado anônimo no mesmo período</p></article>
                <% } %>
            </section>
            <% if (!isAgent) { %>
            <section class="demo-shortcuts" aria-label="Acessos rápidos">
                <a class="demo-panel" href="/chat"><i class="bi bi-chat-dots" aria-hidden="true"></i><span>Acessar Chat<small>Continue suas conversas</small></span><span aria-hidden="true">↗</span></a>
                <a class="demo-panel" href="/agente-politicas"><i class="bi bi-journal-check" aria-hidden="true"></i><span>Agente de Políticas<small>Consulte orientações internas</small></span><span aria-hidden="true">↗</span></a>
                <a class="demo-panel" href="#meu-historico"><i class="bi bi-clock-history" aria-hidden="true"></i><span>Meu histórico<small>Consulte suas interações</small></span><span aria-hidden="true">↓</span></a>
            </section>
            <p class="demo-muted small">Chat e Agente de Políticas são atalhos previstos; os destinos podem ainda não estar disponíveis.</p>
            <% } %>
            <div class="demo-charts <%= isAgent ? 'demo-charts-agents' : '' %>">
                <section class="demo-panel demo-chart-panel">
                    <div class="demo-section-title"><div><h2><%= isAgent ? 'Volume e latência' : 'Meu consumo ao longo do tempo' %></h2><p><%= isAgent ? 'Barras: execuções · linha: latência média em ms' : 'Tokens de entrada e saída por dia' %></p></div><span class="demo-chip"><%= selection.period === 'semanal' ? 'Semanal' : 'Mensal' %></span></div>
                    <div class="demo-chart"><canvas id="timeline-chart" role="img" aria-label="<%= isAgent ? 'Volume diário de execuções e latência média' : 'Consumo diário de tokens próprios' %>">Os valores estão na tabela de dados abaixo.</canvas></div>
                    <details class="demo-chart-data"><summary>Ver dados do gráfico</summary><div class="table-responsive"><table class="table">
                        <thead><tr><th scope="col">Dia</th><th scope="col"><%= isAgent ? 'Execuções' : 'Entrada' %></th><th scope="col"><%= isAgent ? 'Latência média (ms)' : 'Saída' %></th></tr></thead>
                        <tbody><% for (const row of data.timeline) { %><tr><td><%= row.label %></td><td><%= number(isAgent ? row.executions : row.inputTokens) %></td><td><%= number(isAgent ? row.latencyMs : row.outputTokens) %></td></tr><% } %></tbody>
                    </table></div></details>
                </section>
                <section class="demo-panel demo-chart-panel">
                    <div class="demo-section-title"><div><h2><%= isAgent ? 'Tempo por etapa' : 'Comparação anônima' %></h2><p><%= isAgent ? 'Latência média por agente, em milissegundos' : 'Seu total diário e a média agregada de colaboradores' %></p></div><span class="demo-chip"><%= selection.period === 'semanal' ? 'Semanal' : 'Mensal' %></span></div>
                    <div class="demo-chart"><canvas id="detail-chart" role="img" aria-label="<%= isAgent ? 'Latências médias de RAG, ferramenta e geração do LLM' : 'Consumo próprio versus média anônima' %>">Os valores estão na tabela de dados abaixo.</canvas></div>
                    <details class="demo-chart-data"><summary>Ver dados do gráfico</summary><div class="table-responsive"><table class="table">
                    <% if (isAgent) { %>
                        <thead><tr><th>Agente</th><th>RAG (ms)</th><th>Tool (ms)</th><th>LLM (ms)</th><th>Total (ms)</th></tr></thead>
                        <tbody><% for (const row of data.stages) { %><tr><td><%= row.label %></td><td><%= number(row.ragMs) %></td><td><%= number(row.toolMs) %></td><td><%= number(row.llmMs) %></td><td><%= number(row.totalMs) %></td></tr><% } %></tbody>
                    <% } else { %>
                        <thead><tr><th>Dia</th><th>Meu total</th><th>Média anônima</th></tr></thead><tbody>
                        <% for (const row of data.timeline) { %><tr><td><%= row.label %></td><td><%= number(row.totalTokens) %></td><td><%= number(row.averageTokens) %></td></tr><% } %></tbody>
                    <% } %>
                    </table></div></details>
                    <p class="demo-muted small mt-3 mb-0"><%= isAgent ? 'RAG: políticas · tool: projeção orçamentária · LLM: geração. O total pode incluir outros tempos.' : 'Nenhum nome, posição ou consumo individual de outros colaboradores é exibido.' %></p>
                </section>
            </div>
            <p id="chart-message" class="demo-notice" role="status" hidden></p>
            <% if (isAgent) { %>
            <section class="demo-panel demo-records">
                <div class="demo-section-title"><div><h2>Execuções recentes</h2><p>Mais recentes primeiro · horários de Brasília</p></div><span class="demo-chip"><%= data.executions.length %> registros</span></div>
                <div class="table-responsive" role="region" aria-label="Execuções recentes" tabindex="0"><table class="table demo-table" id="execution-table">
                    <caption class="visually-hidden">Execuções simuladas dos agentes no período selecionado</caption>
                    <thead><tr><th scope="col">ID da sessão / horário</th><th scope="col">Modelo</th><th scope="col">Tokens entrada</th><th scope="col">Tokens saída</th><th scope="col">RAG (ms)</th><th scope="col">Tool (ms)</th><th scope="col">Total (ms)</th><th scope="col">Custo (BRL)</th><th scope="col">Status</th></tr></thead>
                    <tbody><% for (const row of data.executions) { %>
                        <tr data-execution-row><td><span class="demo-session"><%= row.sessionId %></span><small><%= date(row.occurredAt) %></small></td><td><%= row.model %></td><td><%= number(row.inputTokens) %></td><td><%= number(row.outputTokens) %></td><td><%= number(row.ragMs) %></td><td><%= number(row.toolMs) %></td><td><%= number(row.totalMs) %></td><td><%= money(row.costBrl) %></td><td><span class="demo-status <%= row.status === 'COMPLETED' ? 'completed' : 'failed' %>"><%= row.status %></span></td></tr>
                    <% } if (!data.executions.length) { %><tr><td colspan="9" class="text-center py-5">Nenhuma execução neste cenário.</td></tr><% } %></tbody>
                </table></div>
                <div class="demo-pagination" id="pagination" hidden><span id="page-label" aria-live="polite"></span><div><button id="previous-page" type="button" class="btn btn-outline-secondary btn-sm">Anterior</button> <button id="next-page" type="button" class="btn btn-outline-secondary btn-sm">Próxima</button></div></div>
            </section>
            <p class="demo-muted small mt-3">Custos estimados da amostra · conversão temporária: US$ 1 = R$ 5,15. Não é uma cotação oficial.</p>
            <% } else { %>
            <section class="demo-panel demo-records" id="meu-historico">
                <div class="demo-section-title"><div><h2>Meu histórico</h2><p>Interações próprias · amostra de navegação</p></div><a class="btn btn-outline-secondary btn-sm" href="/chat/historico">Gerenciar histórico ↗</a></div>
                <div class="table-responsive"><table class="table demo-table"><thead><tr><th>Interação</th><th>Canal</th><th>Data e hora</th><th>Acesso</th></tr></thead><tbody>
                    <% for (const row of data.history) { %><tr><td><%= row.title %></td><td><%= row.channel %></td><td><%= date(row.date) %></td><td><a href="<%= row.href %>">Acessar <span class="visually-hidden"><%= row.channel %></span> ↗</a></td></tr><% } %>
                    <% if (!data.history.length) { %><tr><td colspan="4" class="text-center py-5">Nenhuma interação neste cenário.</td></tr><% } %>
                </tbody></table></div>
            </section>
            <% } %>
        <% } %>
        <footer class="demo-footer">ATLAS · Prévia dos dashboards <span>Dados ilustrativos, sem autenticação ou permissões reais nesta prévia.</span></footer>
    </main>
</div>
<script type="application/json" id="dashboard-data"><%- serialized %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" defer></script>
<script src="/public/js/pages/dashboards.js" defer></script>
<script src="/public/js/pages/management-dashboards.js" defer></script>
