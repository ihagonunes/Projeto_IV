<%- contentFor("espaco-head") %>
<link rel="stylesheet" href="/public/css/pages/dashboards.css?v=spi92-leader">
<% const teamDashboard = ['lider', 'gestor'].includes(profile); %>
<% const compactDashboard = teamDashboard || profile === 'executivo'; %>
<% const spendingBudgetEnabled = typeof canManageSpending !== 'undefined' && canManageSpending; %>
<% const spendingAlertEnabled = typeof canManageSpendingAlert !== 'undefined' && canManageSpendingAlert; %>
<link rel="stylesheet" href="/public/css/pages/dashboard.css?v=20261019-session-actions">
<link rel="stylesheet" href="/public/css/pages/dashboard-redesign.css?v=spi92-budget-chat-1">
<%- contentFor("body") %>

<a class="demo-skip" href="#dashboard-main">Pular para o conteúdo</a>
<div class="demo-shell dashboard-shell">
    <aside class="demo-sidebar dashboard-sidebar" aria-labelledby="dashboard-filters-title">
        <div class="demo-brand atlas-brand"><img src="/public/img/atlas-name.png" alt="ATLAS" class="dashboard-brand-image"><span>Governança de IA</span></div>
        <nav class="dashboard-section-nav" aria-label="Seções do dashboard">
            <a href="#dashboard-main"><i class="bi bi-grid" aria-hidden="true"></i> Visão geral</a>
            <a href="#dashboard-consumption"><i class="bi bi-graph-up" aria-hidden="true"></i> Consumo de IA</a>
            <% if (profile !== 'administrador') { %><a href="#engagement-panel"><i class="bi bi-people" aria-hidden="true"></i> Engajamento</a><% } %>
            <a href="#dashboard-detail"><i class="bi bi-table" aria-hidden="true"></i> Todos os dados</a>
        </nav>
        <section class="dashboard-filter-panel">
            <h2 id="dashboard-filters-title"><i class="bi bi-sliders" aria-hidden="true"></i> Filtros</h2>
            <p class="demo-muted dashboard-filter-description"><%= panel.scope %></p>
            <form id="metrics-filters" data-scope="<%= profile === 'colaborador' ? 'self' : 'authorized' %>" class="demo-filters dashboard-sidebar-filters" aria-label="Filtros do dashboard">
                <div class="dashboard-period-shortcuts" role="group" aria-label="Atalhos de período até a data final">
                    <button type="button" data-dashboard-days="7" disabled>7 dias</button>
                    <button type="button" data-dashboard-days="30" disabled>30 dias</button>
                    <button type="button" data-dashboard-days="90" disabled>90 dias</button>
                </div>
                <div><label for="metrics-from">De</label><input id="metrics-from" type="date" class="form-control custom-input" required></div>
                <div><label for="metrics-to">Até</label><input id="metrics-to" type="date" class="form-control custom-input" required></div>
                <div><label for="metrics-model">Modelo</label><select id="metrics-model" class="form-select custom-input" disabled><option value="">Todos os modelos</option></select></div>
                <div id="metrics-user-field" hidden><label for="metrics-user">Usuário</label><input id="metrics-user" type="search" list="metrics-users" class="form-control custom-input" autocomplete="off" placeholder="Buscar pelo nome"><datalist id="metrics-users"></datalist></div>
                <% if (['gestor', 'executivo', 'administrador'].includes(profile)) { %>
                <div><label for="dashboard-area">Departamento</label><select id="dashboard-area" class="form-select custom-input" disabled><option value="">Todos os departamentos</option></select></div>
                <% } %>
                <button id="metrics-apply" type="submit" class="btn btn-orange" disabled>Aplicar filtros</button>
            </form>
        </section>
        <div class="dashboard-session-actions d-grid gap-2 w-100" aria-label="Navegação e sessão">
            <a href="/onboarding" class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center gap-2"><i class="bi bi-arrow-left" aria-hidden="true"></i><span>Voltar ao onboarding</span></a>
            <button type="button" id="dashboardLogout" class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center gap-2"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sair</span></button>
            <% if (typeof demoProfilesEnabled !== 'undefined' && demoProfilesEnabled) { %>
            <%- include('../../../views/partials/demo-profiles') %>
            <% } %>
        </div>
    </aside>
    <main id="dashboard-main" data-profile="<%= profile %>" data-demo-return="<%= demoReturn %>" class="demo-main dashboard-main">
        <div class="dashboard-workspace"><span>ATLAS <span aria-hidden="true">/</span> <%= panel.scope %></span><span class="dashboard-scope-badge"><i class="bi <%= panel.icon %>" aria-hidden="true"></i> <%= panel.title %></span></div>
        <header class="demo-header">
            <div>
                <p class="demo-eyebrow">WORKSPACE / <%= panel.scope.toLocaleUpperCase('pt-BR') %></p>
                <h1><%= panel.title %></h1>
                <p class="demo-muted"><%= panel.description %></p>
            </div>
            <% if (typeof canAccessChat !== 'undefined' && canAccessChat) { %>
            <a href="/chat" class="dashboard-chat-link"><i class="bi bi-chat-square-text" aria-hidden="true"></i><span>Abrir chat</span><span aria-hidden="true">↗</span></a>
            <% } %>
        </header>
        <% if (spendingBudgetEnabled || spendingAlertEnabled) { %>
        <div class="dashboard-actions mb-3" aria-label="Configuração financeira"><button type="button" data-spending-open class="btn btn-outline-secondary"><%= spendingBudgetEnabled ? 'Definir orçamento e distribuição' : 'Definir alerta de gastos' %></button></div>
        <% } %>
        <section class="demo-panel dashboard-source-panel p-3 mb-3" aria-label="Fonte dos indicadores">
<label for="dashboard-source">Fonte dos cards e gráficos de consumo</label>
<select id="dashboard-source" class="form-select custom-input" disabled><option value="HISTORICO">Histórico importado</option><option value="OPERACIONAL">Operacional</option></select>
<p id="dashboard-source-status" role="status" aria-live="polite">Carregando fonte…</p>
<p class="demo-muted small mb-0">Engajamento usa fonte própria e departamento autorizado: adoção nos 30 dias até a data final e Credits no mês dessa data. Não filtra por modelo ou usuário. Orçamentos e projeções usam o mês operacional indicado em cada bloco.</p>
</section>
        <% for (const section of (panel.analytics || []).filter(section => section.demoOnly && demoReturn)) { %>
        <section class="dashboard-analytics dashboard-productivity mb-4" aria-label="<%= section.title %>">
            <div class="demo-section-title"><div><h2><%= section.title %></h2><p class="dashboard-method-note"><%= section.description %></p></div></div>
            <div class="demo-kpis">
                <% for (const label of section.kpis) { %>
                <article class="demo-panel demo-kpi" data-dashboard-kpi="<%= label %>"><span><%= label %></span><strong>Sem dado</strong><p><%= indicatorReason(label) %></p></article>
                <% } %>
            </div>
            <div class="demo-charts">
                <% for (const [title, description] of section.charts) { %>
                <section class="demo-panel demo-chart-panel">
                    <div class="demo-section-title"><div><h3 class="dashboard-chart-title"><%= title %></h3><p><%= description %></p></div></div>
                    <div data-dashboard-chart="<%= title %>" class="dashboard-chart-slot"><p><%= indicatorReason(title) %></p></div>
                </section>
                <% } %>
            </div>
        </section>
        <% } %>
        <section class="demo-kpis dashboard-summary" aria-label="Indicadores">
            <% for (const label of panel.kpis) { %>
            <article class="demo-panel demo-kpi" data-dashboard-kpi="<%= label %>"><span><%= label %></span><strong>Sem dado</strong><p><%= indicatorReason(label) %></p></article>
            <% } %>
        </section>
        <% const primaryChartTitle = { colaborador: 'Comparação anônima', lider: 'Modelos usados pela equipe', gestor: 'Distribuição de modelos', executivo: 'Benchmarking entre departamentos' }[profile]; %>
        <% if (profile !== 'administrador') { %>
        <div class="dashboard-overview-grid">
            <%- include('timeline') %>
            <% for (const chart of panel.charts.filter(chart => chart[0] === primaryChartTitle)) { %><%- include('chart-card', { chart }) %><% } %>
        </div>
        <% } %>
        <% if (panel.actions) { %>
        <section class="dashboard-actions mb-3" aria-label="Ações">
            <% for (const action of panel.actions) { const href = action === 'Ir para o Chat' || action === 'Gerenciar / excluir meu histórico' ? '/chat' : null; %>
<% if (href) { %><a class="btn btn-outline-secondary" href="<%= href %>"><%= action %></a><% } else { %><button type="button" class="btn btn-outline-secondary" disabled title="Ação ainda não integrada neste painel"><%= action %></button><% } %><% } %>
        </section>
        <% } %>
        <% if (profile !== 'colaborador') { %>
        <section id="budget-notification" class="demo-panel p-3 mb-4" aria-labelledby="budget-notification-title" hidden>
            <div class="budget-overview-header"><div><span class="budget-eyebrow">ACOMPANHAMENTO FINANCEIRO</span><h2 id="budget-notification-title" class="h5">Orçamento por departamento</h2></div><span id="budget-notification-period" class="budget-period"></span></div>
            <p id="budget-notification-message" role="status" aria-live="polite"></p>
            <div class="budget-overview-stats" aria-label="Resumo dos departamentos">
                <div><span>Departamentos</span><strong id="budget-notification-total">—</strong></div>
                <div><span>Em alerta</span><strong id="budget-notification-alerts">—</strong></div>
                <div><span>Sem orçamento</span><strong id="budget-notification-missing">—</strong></div>
            </div>
            <details id="budget-notification-details" hidden>
                <summary><i id="budget-notification-icon" class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span id="budget-notification-summary"></span>
                    <span id="budget-notification-count" class="badge text-bg-warning"></span>
                </summary>
                <div class="budget-table-scroll" role="region" aria-label="Orçamento dos departamentos" tabindex="0"><table class="budget-departments-table">
                    <caption>Orçamento departamental operacional. A API não informa a moeda dos valores.</caption>
                    <thead><tr><th scope="col">Departamento</th><th scope="col">Situação</th><th scope="col">Orçamento</th><th scope="col">Consumo</th><th scope="col">Saldo</th><th scope="col">Utilização</th></tr></thead>
                    <tbody id="budget-notification-items"></tbody>
                </table></div>
            </details>
            <button id="budget-notification-retry" type="button" class="btn btn-outline-secondary btn-sm" hidden>Tentar novamente</button>
        </section>
        <section id="budget-projection-panel" class="demo-panel p-3 mb-4" aria-labelledby="budget-projection-title" hidden>
            <div class="engagement-header">
                <div>
                    <h2 id="budget-projection-title" class="h5">Projeção do mês</h2>
                    <p class="demo-muted small mb-0">Média móvel do custo conhecido; cálculo determinístico, sem chamada a LLM.</p>
                </div>
                <div class="engagement-source">
                    <label for="budget-projection-department">Departamento</label>
                    <select id="budget-projection-department" class="form-select custom-input" disabled></select>
                </div>
            </div>
            <p id="budget-projection-message" role="status" aria-live="polite"></p>
            <div id="budget-projection-content" hidden>
                <div class="demo-kpis">
                    <article class="demo-kpi"><span>Gasto até hoje</span><strong id="budget-projection-spent">—</strong></article>
                    <article class="demo-kpi"><span>Projetado para o mês</span><strong id="budget-projection-projected">—</strong></article>
                    <article class="demo-kpi"><span>Dia de esgotamento</span><strong id="budget-projection-exhaustion">—</strong></article>
                    <article class="demo-kpi"><span>Recomendação</span><strong id="budget-projection-recommendation">—</strong><small id="budget-projection-status" class="demo-muted"></small></article>
                </div>
                <div id="budget-projection-chart" aria-label="Comparação de gasto, projeção e orçamento"></div>
                <p id="budget-projection-detail" class="demo-muted small mb-0"></p>
            </div>
            <button id="budget-projection-retry" type="button" class="btn btn-outline-secondary btn-sm" hidden>Tentar novamente</button>
        </section>
        <% } %>
        <% if (['colaborador', 'lider', 'gestor', 'executivo'].includes(profile)) { %>
        <section id="engagement-panel" class="demo-panel p-3 mb-4" data-scope="<%= profile === 'colaborador' ? 'self' : 'authorized' %>" aria-labelledby="engagement-title">
            <div class="engagement-header">
                <div>
                    <h2 id="engagement-title" class="h5"><%= profile === 'colaborador' ? 'Meus AI Credits' : 'Engajamento da área' %></h2>
                    <p class="demo-muted small mb-0">Adoção, treinamento e AI Credits em fontes separadas; os valores nunca são somados entre operacional e histórico.</p>
                </div>
                <div class="engagement-source">
                    <label for="engagement-source">Fonte</label>
                    <select id="engagement-source" class="form-select custom-input" disabled>
                        <option value="OPERACIONAL">Operacional</option>
                        <option value="HISTORICO" selected>Histórico</option>
                    </select>
                </div>
            </div>
            <p id="engagement-message" role="status" aria-live="polite">Carregando engajamento…</p>
            <div id="engagement-content" hidden>
                <% if (profile !== 'colaborador') { %>
                <section id="engagement-adoption" aria-labelledby="engagement-adoption-title">
                    <h3 id="engagement-adoption-title" class="h6 mt-3">Adoção (30 dias)</h3>
                    <p id="engagement-adoption-source" class="demo-muted small"></p>
                    <div class="demo-kpis">
                        <article class="demo-kpi"><span>Taxa de adoção</span><strong id="engagement-adoption-rate">—</strong><small id="engagement-adoption-status" class="demo-muted"></small></article>
                        <article class="demo-kpi"><span>Ativos / elegíveis</span><strong id="engagement-adoption-active">—</strong></article>
                        <article class="demo-kpi"><span>Licenças ociosas</span><strong id="engagement-adoption-idle">—</strong></article>
                        <article class="demo-kpi"><span>Data de corte</span><strong id="engagement-adoption-date">—</strong></article>
                    </div>
                    <p id="engagement-adoption-note" class="demo-muted small" role="status"></p>
                    <div class="engagement-donut-row">
                        <div id="engagement-donut" class="engagement-donut" role="img" aria-label="Adoção sem dados"><span id="engagement-donut-label">Sem dado</span></div>
                        <p id="engagement-coverage" class="demo-muted small mb-0"></p>
                    </div>
                    <h4 class="h6 mt-3">Adoção por departamento</h4>
                    <div class="table-responsive"><table class="table demo-table"><caption class="visually-hidden">Adoção por departamento</caption><thead><tr><th scope="col">Departamento</th><th scope="col">Elegíveis</th><th scope="col">Ativos</th><th scope="col">Taxa</th></tr></thead><tbody id="engagement-departments"></tbody></table></div>
                </section>
                <section id="engagement-training" aria-labelledby="engagement-training-title">
                    <h3 id="engagement-training-title" class="h6 mt-4">Treinamento × uso (4 quadrantes)</h3>
                    <p id="engagement-training-source" class="demo-muted small"></p>
                    <div id="engagement-quadrants" class="engagement-quadrants<%= compactDashboard ? ' engagement-quadrants--leader' : '' %>"></div>
                    <p id="engagement-training-note" class="demo-muted small" role="status"></p>
                    <div id="engagement-nominal" hidden></div>
                    <p id="engagement-training-coverage" class="demo-muted small mb-0"></p>
                </section>
                <% } %>
                <section id="engagement-credits" aria-labelledby="engagement-credits-title">
                    <h3 id="engagement-credits-title" class="h6 mt-4"><%= profile === 'colaborador' ? 'Meus AI Credits' : 'AI Credits da equipe' %></h3>
                    <p id="engagement-credits-source" class="demo-muted small"></p>
                    <div id="engagement-credits-personal" hidden>
                        <div class="demo-kpis">
                            <article class="demo-kpi"><span>Score</span><strong id="engagement-credits-score">—</strong><small id="engagement-credits-status" class="demo-muted"></small></article>
                            <article class="demo-kpi"><span>Uso</span><strong id="engagement-credits-usage">—</strong></article>
                            <article class="demo-kpi"><span>Treinamento</span><strong id="engagement-credits-training">—</strong></article>
                            <article class="demo-kpi"><span>Licença</span><strong id="engagement-credits-license">—</strong></article>
                        </div>
                    </div>
                    <div id="engagement-credits-team" hidden>
                        <div class="demo-kpis">
                            <article class="demo-kpi"><span>Participantes</span><strong id="engagement-credits-total">—</strong></article>
                            <article class="demo-kpi"><span>Score médio</span><strong id="engagement-credits-average">—</strong></article>
                            <article class="demo-kpi"><span>Componentes médios</span><strong id="engagement-credits-components" class="engagement-components">—</strong></article>
                        </div>
                        <h4 class="h6 mt-3">Distribuição por faixa de score (sem ranking)</h4>
                        <div id="engagement-credits-buckets" class="engagement-buckets"></div>
                    </div>
                    <p id="engagement-credits-note" class="demo-muted small" role="status"></p>
                    <p id="engagement-credits-coverage" class="demo-muted small mb-0"></p>
                </section>
            </div>
        </section>
        <% } %>
        <% if (panel.management && (profile !== 'executivo' || canManageBudget)) { const section = panel.management; %>
        <section class="demo-panel demo-chart-panel mb-3" data-dashboard-management="<%= section.title %>" aria-label="<%= section.title %>">
            <div class="demo-section-title"><div><h2><%= section.title %></h2><p><%= section.description %></p></div></div>
            <% if (section.fields) { %>
            <div class="row g-3 mb-3"><% for (const field of section.fields) { %><div class="col-12 col-md-4"><div class="dashboard-budget"><span><%= field %></span><strong>—</strong></div></div><% } %></div>
            <% } %>
            <div class="dashboard-actions"><% for (const action of section.actions) { %>
                <% if (action === 'Ajustar orçamento' && canManageBudget) { %>
                <% if (spendingBudgetEnabled) { %><p class="demo-muted small mb-0">Use “Definir orçamento e distribuição” no topo do dashboard para configurar o mês.</p><% } %>
                <% } else { %>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled><%= action %></button>
                <% } %>
            <% } %></div>
            <p class="demo-muted small mb-0 mt-3"><%= canManageBudget ? "Distribuição automática por departamento e hierarquia." : (section.fields ? "O executivo define o orçamento mensal." : "A exportação ainda está indisponível.") %></p>
        </section>
        <% } %>
        <div class="demo-charts">
            <% for (const [title, description, source] of panel.charts.filter(chart => chart[0] !== primaryChartTitle && !['Meu consumo ao longo do tempo', 'Evolução dos gastos do departamento', 'FinOps corporativo'].includes(chart[0]))) { %>
            <section class="demo-panel demo-chart-panel"<% if (source) { %> data-dashboard-chart-source="<%= source %>" hidden<% } %>>
                <div class="demo-section-title"><div><h2><%= title %></h2><p><%= description %></p></div></div>
                <div data-dashboard-chart="<%= title %>" class="dashboard-chart-slot"><p><%= indicatorReason(title) %></p></div>
            </section>
            <% } %>
        </div>
        <% for (const section of (panel.analytics || []).filter(section => !section.demoOnly)) { %>
        <section class="dashboard-analytics mb-4" aria-label="<%= section.title %>">
            <div class="demo-section-title"><div><h2><%= section.title %></h2><p class="dashboard-method-note"><%= section.description %></p></div></div>
            <div class="demo-kpis">
                <% for (const label of section.kpis) { %>
                <article class="demo-panel demo-kpi" data-dashboard-kpi="<%= label %>"><span><%= label %></span><strong>Sem dado</strong><p><%= indicatorReason(label) %></p></article>
                <% } %>
            </div>
            <div class="demo-charts">
                <% for (const [title, description] of section.charts) { %>
                <section class="demo-panel demo-chart-panel">
                    <div class="demo-section-title"><div><h3 class="dashboard-chart-title"><%= title %></h3><p><%= description %></p></div></div>
                    <div data-dashboard-chart="<%= title %>" class="dashboard-chart-slot"><p><%= indicatorReason(title) %></p></div>
                </section>
                <% } %>
            </div>
        </section>
        <% } %>
        <% if (panel.highlights) { %>
        <div class="row g-3 mb-3"><% for (const title of panel.highlights) { %>
            <div class="col-12 col-lg-6"><section class="demo-panel demo-chart-panel h-100"><div class="demo-section-title"><div><h2><%= title %></h2></div></div><div class="dashboard-highlight-slot" data-dashboard-highlight="<%= title %>">Carregando cruzamento de treinamento e uso…</div></section></div>
        <% } %></div>
        <% } %>
        <% for (const [title, description, columns] of panel.tables) { %>
        <section class="demo-panel demo-records mb-3" data-dashboard-table="<%= title %>">
            <div class="demo-section-title"><div><h2><%= title %></h2><p><%= description %></p></div></div>
            <div class="table-responsive"><table class="table demo-table">
                <caption class="visually-hidden"><%= title %> — registros autorizados</caption>
                <thead><tr><% for (const column of columns) { %><th scope="col"><%= column %></th><% } %></tr></thead>
                <tbody><tr><td colspan="<%= columns.length %>" class="text-center py-5 demo-muted"><%= indicatorReason(title) %></td></tr></tbody>
            </table></div>
        </section>
        <% } %>
        <details id="dashboard-detail" class="demo-panel dashboard-data-details">
            <summary>Todos os dados de consumo <span>Histórico e operacional, em fontes separadas</span></summary>
            <div class="dashboard-data-details-body">
        <section class="demo-panel p-3 mb-4" aria-labelledby="historical-title">
            <h2 id="historical-title" class="h5"><%= profile === 'colaborador' ? 'Meu consumo de IA' : 'Histórico de consumo' %></h2>
            <p>Dados importados da empresa. Custo estimado em USD pelo catálogo histórico; não corresponde ao faturamento.</p>
            <p id="historical-message" role="status" aria-live="polite">Carregando histórico…</p>
            <div id="historical-content" hidden>
                <p id="historical-coverage" class="demo-muted"></p>
                <div class="demo-kpis<%= profile === 'colaborador' ? ' dashboard-personal-kpis' : '' %>">
                    <article class="demo-kpi"><span>Requisições históricas</span><strong id="historical-requests">—</strong></article>
                    <% if (profile !== 'colaborador') { %>
                    <article class="demo-kpi"><span>Funcionários ativos no período</span><strong id="historical-active">—</strong></article>
                    <% } %>
                    <article class="demo-kpi"><span>Tokens entrada / saída</span><strong id="historical-tokens">—</strong></article>
                    <article class="demo-kpi"><span>Custo histórico estimado (USD)</span><strong id="historical-cost">—</strong></article>
                </div>
                <% if (profile !== 'colaborador') { %>
                <h3 class="h6 mt-3">Requisições por dia</h3>
                <div id="historical-series"<% if (compactDashboard) { %> class="dashboard-daily-series"<% } %>></div>
                <% } %>
                <h3 class="h6 mt-3">Consumo por modelo</h3>
                <div class="table-responsive"><table class="table demo-table"><thead><tr><th>Modelo</th><th>Requisições</th><th>Tokens entrada / saída</th><th>Custo estimado (USD)</th></tr></thead><tbody id="historical-costs"></tbody></table></div>
            </div>
            <button id="historical-retry" class="btn btn-outline-secondary btn-sm" hidden>Tentar novamente</button>
        </section>
        <section class="demo-panel p-3 mb-4" aria-label="Métricas de uso filtradas">
            <h2 class="h5"><%= profile === 'colaborador' ? 'Meu uso operacional' : 'Uso e custo no período' %></h2>
            <% if (teamDashboard) { %>
            <p class="demo-muted small">Dados operacionais dos departamentos aos quais seu perfil tem acesso. Os totais seguem o período e os demais filtros selecionados.</p>
            <% } %>
            <p id="metrics-message" role="status" aria-live="polite">Carregando métricas…</p>
            <div class="demo-kpis">
                <article class="demo-kpi"><span>Requisições</span><strong id="metrics-requests">—</strong></article>
