<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="atlas-onboarding-wrapper step-bg-usuarios">

    <%- include("../../../views/partials/wizard-stepper", { activeStep: 3 }) %>

    <main class="atlas-content">

        <div class="atlas-page-header">
            <h1 class="atlas-page-title">Cadastro Manual de Usuário</h1>
            <p class="atlas-page-subtitle">Adicione usuários individualmente à plataforma.</p>
        </div>

        <div class="atlas-card">
            <form id="usuarioManualForm" action="/onboarding/usuarios/hub" method="GET" novalidate>

                <p class="atlas-section-title">Dados do Usuário</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="nomeUsuario" class="form-label-custom">Nome completo *</label>
                        <input type="text" class="form-control custom-input" id="nomeUsuario" required>
                    </div>
                    <div class="col-md-6">
                        <label for="emailUsuario" class="form-label-custom">E-mail corporativo *</label>
                        <input type="email" class="form-control custom-input" id="emailUsuario" placeholder="usuario@empresa.com" required>
                    </div>

                    <div class="col-md-6">
                        <label for="departamentoUsuario" class="form-label-custom">Departamento</label>
                        <select class="form-select custom-input" id="departamentoUsuario">
                            <option value="" disabled selected>Selecione...</option>
                            <option value="ti">Tecnologia da Informação</option>
                            <option value="rh">Recursos Humanos</option>
                            <option value="financeiro">Financeiro</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="nivelHierarquico" class="form-label-custom">Nível hierárquico *</label>
                        <select class="form-select custom-input" id="nivelHierarquico" required>
                            <option value="" disabled selected>Selecione...</option>
                            <option value="diretoria">Diretoria</option>
                            <option value="gerencia">Gerência</option>
                            <option value="coordenacao">Coordenação</option>
                            <option value="operacional">Operacional</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="permissao" class="form-label-custom">Permissão administrativa *</label>
                        <select class="form-select custom-input" id="permissao" required>
                            <option value="" disabled selected>Selecione...</option>
                            <option value="admin">Administrador</option>
                            <option value="comum">Usuário Comum</option>
                            <option value="leitor">Apenas Leitura</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="cargoUsuario" class="form-label-custom">Cargo *</label>
                        <input type="text" class="form-control custom-input" id="cargoUsuario" required>
                    </div>
                </div>

                <div class="atlas-form-footer">
                    <a href="/onboarding/usuarios/hub" class="btn btn-outline-secondary btn-pill">← voltar</a>
                    <button type="submit" class="btn btn-orange btn-pill fw-bold px-4">próximo →</button>
                </div>
            </form>
        </div>

    </main>
</div>

<script src="/public/js/pages/onboarding/step-usuarios.js"></script>
