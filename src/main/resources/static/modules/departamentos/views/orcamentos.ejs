<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="atlas-onboarding-wrapper step-bg-departamentos">

    <main class="atlas-content">

        <div class="atlas-page-header">
            <h1 class="atlas-page-title">Orçamento por departamento</h1>
            <p class="atlas-page-subtitle">
                Defina o orçamento mensal e o limiar de alerta. O orçamento alerta, mas não bloqueia o uso.
            </p>
        </div>

        <div class="atlas-card">
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-4">
                    <label for="orcamentoMes" class="form-label-custom">Mês de referência</label>
                    <input type="month" class="form-control custom-input" id="orcamentoMes" required>
                </div>
            </div>

            <div id="orcamentosMensagem" class="d-none"></div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Departamento</th>
                            <th class="text-end">Orçamento (R$)</th>
                            <th class="text-end">Limiar (%)</th>
                            <th class="text-end">Custo real</th>
                            <th>Consumo do orçamento</th>
                            <th>Situação</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="orcamentosTableBody">
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">Carregando orçamentos...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="text-muted small mb-0">
                Sem valor definido, o departamento aparece como "Sem orçamento" (nunca como zero).
                O histórico lista apenas os meses com orçamento próprio cadastrado.
            </p>

            <div class="atlas-form-footer">
                <a href="/dashboard" class="btn btn-outline-secondary btn-pill">← voltar</a>
            </div>
        </div>

        <div class="atlas-card mt-4">
            <h2 class="atlas-section-title" id="historicoTitulo">Histórico dos últimos 12 meses</h2>
            <div id="historicoMensagem" class="text-muted small">Selecione "Histórico" em um departamento.</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mês</th>
                            <th class="text-end">Orçamento (R$)</th>
                            <th class="text-end">Limiar (%)</th>
                            <th>Atualizado em</th>
                        </tr>
                    </thead>
                    <tbody id="historicoTableBody"></tbody>
                </table>
            </div>
        </div>

    </main>
</div>

<dialog id="orcamentoEditor" class="border-0 rounded p-4" aria-labelledby="orcamentoEditorTitulo">
    <form id="orcamentoEditorForm">
        <h2 id="orcamentoEditorTitulo" class="h5">Editar orçamento mensal</h2>
        <p id="orcamentoEditorDepartamento"></p>
        <div class="mb-3">
            <label for="orcamentoEditorValor" class="form-label">Orçamento (R$)</label>
            <input id="orcamentoEditorValor" type="number" min="0" max="9999999999999.99" step="0.01" required class="form-control" aria-describedby="orcamentoEditorAjuda">
            <small id="orcamentoEditorAjuda">Informe um valor não negativo, com até duas casas decimais.</small>
        </div>
        <div class="mb-3">
            <label for="orcamentoEditorLimiar" class="form-label">Limiar de alerta (%)</label>
            <input id="orcamentoEditorLimiar" type="number" min="1" max="100" step="1" required class="form-control">
        </div>
        <p id="orcamentoEditorMensagem" role="alert"></p>
        <div class="d-flex justify-content-end gap-2">
            <button id="orcamentoEditorCancelar" type="button" class="btn btn-outline-secondary">Cancelar</button>
            <button id="orcamentoEditorSalvar" type="submit" class="btn btn-primary">Salvar orçamento</button>
        </div>
    </form>
</dialog>

<script src="/public/js/core/api-client.js?v=cookie-session-20261022"></script>
<script src="/public/js/pages/orcamentos.js?v=spi121-executive"></script>
