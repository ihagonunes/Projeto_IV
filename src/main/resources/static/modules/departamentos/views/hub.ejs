<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">

<div class="atlas-onboarding-wrapper step-bg-departamentos">

    <%- include("../../../views/partials/wizard-stepper", { activeStep: 2 }) %>

    <main class="atlas-content">

        <div class="atlas-page-header">
            <h1 class="atlas-page-title">Departamentos</h1>
            <p class="atlas-page-subtitle">Escolha como deseja gerenciar os departamentos da sua empresa.</p>
        </div>

        <div class="atlas-card">
            <p class="atlas-section-title">O que você quer fazer?</p>

            <div class="row g-4 my-2">
                <div class="col-md-4">
                    <a href="/onboarding/departamentos/add" class="hub-card">
                        <i class="bi bi-plus-circle hub-card-icon"></i>
                        <span>Adicionar departamento</span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/onboarding/departamentos/form?mode=edit" class="hub-card">
                        <i class="bi bi-pencil-square hub-card-icon"></i>
                        <span>Editar departamento</span>
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/onboarding/departamentos/listar" class="hub-card">
                        <i class="bi bi-list-ul hub-card-icon"></i>
                        <span>Listar departamentos</span>
                    </a>
                </div>
            </div>

            <div class="atlas-form-footer">
                <a href="/onboarding/admin" class="btn btn-outline-secondary btn-pill">← voltar</a>
                <a href="/onboarding/usuarios/hub" class="btn btn-orange btn-pill fw-bold px-4">próximo →</a>
            </div>
        </div>

    </main>
</div>

<script src="/public/js/pages/onboarding/step-departamentos.js"></script>
