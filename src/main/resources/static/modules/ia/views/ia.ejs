<%- contentFor("espaco-head") %>
<link href="/public/css/components/onboarding-card.css" rel="stylesheet">
<link href="/public/css/components/data-grid.css" rel="stylesheet">
<link href="/public/css/pages/onboarding.css" rel="stylesheet">
<%- contentFor("body") %>

<div class="atlas-onboarding-wrapper step-bg-ia">
    <%- include("../../../views/partials/wizard-stepper", { activeStep: 4 }) %>

    <main class="atlas-content">
        <div class="atlas-page-header">
            <h1 class="atlas-page-title">Catálogo de IA</h1>
            <p class="atlas-page-subtitle">Provedores, modelos e política por departamento. O segredo nunca é exibido nem solicitado.</p>
        </div>

        <p id="iaMessage" class="atlas-form-message" role="status" aria-live="polite"></p>

        <section id="iaRestricted" class="atlas-card" hidden>
            <p class="atlas-section-title">Acesso restrito</p>
            <p>Seu perfil não possui <code>AI_TOOL:MANAGE</code> para administrar o catálogo de IA.</p>
            <a href="/onboarding" class="btn btn-outline-secondary btn-pill">Voltar ao onboarding</a>
        </section>

        <div id="iaContent" hidden>
            <section class="atlas-card mb-4" aria-labelledby="providersTitle">
                <p class="atlas-section-title" id="providersTitle">Provedores</p>
                <p class="text-muted small">O campo “credencial” é apenas o nome da variável de ambiente. O valor do segredo não é lido nem exibido.</p>
                <div class="data-grid-container">
                    <table class="data-grid">
                        <thead>
                            <tr><th>Provedor</th><th>Tipo</th><th>Base URL</th><th>Credencial</th><th>Status</th></tr>
                        </thead>
                        <tbody id="provedoresTableBody"></tbody>
                    </table>
                </div>
            </section>

            <section class="atlas-card mb-4" aria-labelledby="modelsTitle">
                <p class="atlas-section-title" id="modelsTitle">Modelos</p>
                <div class="data-grid-container">
                    <table class="data-grid">
                        <thead>
                            <tr><th>Modelo</th><th>Provider</th><th>Departamentos autorizados</th><th>Status</th><th>Nome externo</th><th>Preço entrada /1k</th><th>Preço saída /1k</th><th>Ações</th></tr>
                        </thead>
                        <tbody id="modelosTableBody"></tbody>
                    </table>
                </div>
                <p id="modelsMessage" class="text-muted small" role="status" aria-live="polite"></p>
            </section>

            <section class="atlas-card mb-4" aria-labelledby="policyTitle">
                <p class="atlas-section-title" id="policyTitle">Política por departamento</p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="policyDepartment" class="form-label-custom">Departamento</label>
                        <select id="policyDepartment" class="form-select custom-input"></select>
                    </div>
                    <div class="col-md-4">
                        <label for="policyDefault" class="form-label-custom">Modelo padrão</label>
                        <select id="policyDefault" class="form-select custom-input" disabled></select>
                    </div>
                    <div class="col-md-3">
                        <button id="policySave" type="button" class="btn btn-orange btn-pill w-100" disabled>Salvar política</button>
                    </div>
                </div>
                <fieldset id="policyModels" class="mt-3">
                    <legend class="form-label-custom">Modelos permitidos</legend>
                </fieldset>
                <p id="policyMessage" class="text-muted small" role="status" aria-live="polite"></p>
            </section>

            <div class="atlas-form-footer">
                <a href="/onboarding/usuarios/hub" class="btn btn-outline-secondary btn-pill">← voltar</a>
                <a href="/onboarding/revisao" class="btn btn-orange btn-pill fw-bold px-4">próximo →</a>
            </div>
        </div>
    </main>
</div>

<script src="/public/js/core/api-client.js?v=cookie-session-20261022"></script>
<script src="/public/js/pages/onboarding/step-ia.js?v=spi-87-20261101"></script>
