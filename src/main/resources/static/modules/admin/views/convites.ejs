<%- contentFor("espaco-head") %>
<link href="/public/css/components/auth-card.css" rel="stylesheet">
<link href="/public/css/components/data-grid.css" rel="stylesheet">
<link href="/public/css/pages/admin-convites.css" rel="stylesheet">

<div class="container py-5">

    <!-- Cabeçalho Administrativo e Toggle de Perfil para Testes -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Gestão de Convites de Usuários</h1>
            <p class="text-muted mb-0 small">Emissão de novos convites e acompanhamento do estado das solicitações.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div id="roleBadgeContainer" class="admin-header-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-shield-check" viewBox="0 0 16 16">
                    <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.134a.1.1 0 0 0 .01.003c.001.001.006.002.012.002l.002.001.001.001.001.001c.242-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067s-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.5 1.5 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.5 1.5 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                    <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                </svg>
                <span id="roleBadgeText">Verificando permissões...</span>
            </div>
        </div>
    </div>

    <!-- Área de Alerta para Restrição de Acesso -->
    <div id="accessDeniedBanner" class="access-restricted-banner mb-4 d-none">
        <div class="d-flex align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill me-3 flex-shrink-0" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>
                <strong class="d-block fs-6">Acesso Restrito a Administradores</strong>
                <span class="small">Você está utilizando um perfil sem permissões administrativas. Apenas administradores possuem autorização para emitir ou gerenciar convites de acesso.</span>
            </div>
        </div>
    </div>

    <!-- Container de Notificações / Toast Feedbacks -->
    <div id="alertArea" class="mb-4"></div>

    <!-- Link do convite: exibido apenas na emissão/reenvio (token não é listado) -->
    <div id="inviteLinkPanel" class="alert alert-success d-none">
        <strong class="d-block mb-1">Link do convite (aparece uma única vez)</strong>
        <span class="small">Encaminhe este link ao convidado; ele não será exibido novamente.</span>
        <div class="input-group mt-2">
            <input type="text" class="form-control" id="inviteLinkInput" readonly aria-label="Link do convite">
            <button class="btn btn-outline-success" type="button" id="btnCopiarLink">Copiar</button>
        </div>
    </div>

    <div class="row g-4">
        
        <!-- Formulário de Emissão de Convite -->
        <div class="col-lg-5">
            <div id="conviteFormCard" class="admin-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 fw-bold text-dark mb-0">Novo Convite</h2>
                    <span class="badge bg-light text-secondary border">Passo 1</span>
                </div>
                <p class="text-muted small mb-4">Informe o e-mail, departamento e atribua o papel adequado ao modelo de permissões do sistema.</p>

                <form id="formEmitirConvite" action="#" method="POST" novalidate>

                    <!-- E-mail -->
                    <div class="mb-3">
                        <label for="emailConvite" class="form-label-custom fw-medium">E-mail do Convidado *</label>
                        <input type="email" class="form-control custom-input" id="emailConvite" placeholder="ex: usuario@empresa.com" required>
                        <div class="invalid-feedback small mt-1">
                            Informe um e-mail corporativo válido.
                        </div>
                    </div>

                    <!-- Departamento -->
                    <div class="mb-3">
                        <label for="departamentoConvite" class="form-label-custom fw-medium">Departamento *</label>
                        <select class="form-select custom-input" id="departamentoConvite" required>
                            <option value="" disabled selected>Carregando departamentos...</option>
                        </select>
                        <div class="invalid-feedback small mt-1">
                            Selecione o departamento do usuário.
                        </div>
                    </div>

                    <!-- Papel / Permissão -->
                    <div class="mb-3">
                        <label for="papelConvite" class="form-label-custom fw-medium">Papel / Permissão *</label>
                        <select class="form-select custom-input" id="papelConvite" required>
                            <option value="" disabled selected>Carregando papéis...</option>
                        </select>
                        <div class="invalid-feedback small mt-1">
                            Selecione o papel permitido.
                        </div>
                    </div>

                    <!-- Botões -->
                    <div class="d-grid gap-2">
                        <button type="submit" id="btnEnviarConvite" class="btn btn-orange btn-pill text-white fw-bold d-flex align-items-center justify-content-center gap-2">
                            <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span>Enviar Convite</span>
                        </button>
                        <button type="button" id="btnLimparForm" class="btn btn-outline-secondary btn-pill">Limpar formulário</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Tabela / Grid de Estado dos Convites -->
        <div class="col-lg-7">
            <div class="admin-card p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <div>
                        <h2 class="h5 fw-bold text-dark mb-0">Convites Emitidos</h2>
                        <span class="text-muted small">Lista de solicitações registradas e seus respectivos status.</span>
                    </div>
                    <span id="totalConvitesBadge" class="badge bg-secondary rounded-pill fs-6 px-3">0 convites</span>
                </div>

                <!-- Barra de Filtros e Busca -->
                <div class="filter-bar mb-3">
                    <div class="row g-2">
                        <div class="col-md-7">
                            <input type="text" id="searchInput" class="form-control form-control-sm custom-input" placeholder="Buscar por e-mail...">
                        </div>
                        <div class="col-md-5 d-flex gap-2">
                            <select id="statusFilter" class="form-select form-select-sm custom-input">
                                <option value="TODOS">Todos os Status</option>
                                <option value="PENDING">Pendente</option>
                                <option value="ACCEPTED">Aceito</option>
                                <option value="REVOKED">Cancelado</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Grid de Dados (Data Grid) -->
                <div class="data-grid-container">
                    <table class="data-grid text-nowrap">
                        <thead>
                            <tr>
                                <th>E-mail</th>
                                <th>Departamento</th>
                                <th>Papel</th>
                                <th>Criado em</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="convitesTableBody">
                            <!-- Inserido dinamicamente via JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Estado Vazio -->
                <div id="emptyState" class="text-center py-5 d-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="#CCC" class="bi bi-inbox mb-2" viewBox="0 0 16 16">
                        <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.917 5H11.5a2.5 2.5 0 0 1-5 0H1.103l.289 2.89A1.5 1.5 0 0 0 2.884 13h10.232a1.5 1.5 0 0 0 1.492-1.11L14.897 9z"/>
                    </svg>
                    <p class="text-muted small mb-0">Nenhum convite encontrado para os filtros selecionados.</p>
                </div>

            </div>
        </div>

    </div>

    <!-- Navegação de Retorno -->
    <div class="mt-4 text-center">
        <a href="/tenant" class="text-decoration-none text-muted small">← Voltar para o Onboarding</a>
    </div>

</div>

<!-- Scripts da Página -->
<script src="/public/js/core/api-client.js"></script>
<script src="/public/js/pages/admin-convites.js"></script>
