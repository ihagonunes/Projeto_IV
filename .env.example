DB_HOST=localhost
# BUGFIX-DB-001: use um arquivo local separado, por exemplo .env.v3.local,
# e scripts/run-local.ps1 -EnvFile .env.v3.local (Git Bash: run-local.sh arquivo).
# Para o BFF, defina QSOFT_ENV_FILE com o caminho do mesmo arquivo antes de npm start.
DB_PORT=5432
DB_NAME=qsoft_governance
DB_USER=qsoft
DB_PASSWORD=change_me_local
SERVER_PORT=8080
# OpenAPI/Swagger (dashboard da API). Em produção, defina false para não expor.
OPENAPI_ENABLED=true
# Frontend (BFF Node): alvo do proxy /api/* para o backend Spring Boot.
API_PROXY_TARGET=http://localhost:8080
# Slug do tenant exposto pelo BFF ao front (window.QSOFT_TENANT_SLUG) para o login.
# Se vazio, o backend resolve o tenant pelo domínio do email (ADR-32).
# QSOFT_TENANT_SLUG=qsoft

# Frontend (BFF Node) — variáveis lidas do .env pelo Express/axios server-side:
# URL base do back usada pela instância axios de config/api.js (módulos do frontend).
SPRING_API_URL=http://localhost:8080
# Porta e IP de bind do servidor Express (BFF).
PORT=3000
IP=127.0.0.1
# Segredo de assinatura/validação do JWT (ADR-30). OBRIGATÓRIO (mínimo 32 chars).
# Sem valor, a aplicação NÃO sobe (não há default inseguro no repositório).
JWT_SECRET=<defina-um-segredo-forte-com-32-ou-mais-caracteres>

# Seed de demonstração (tenant qsoft + admin) — DESABILITADO por padrão.
# Habilite apenas em desenvolvimento, definindo as DUAS variáveis:
# APP_BOOTSTRAP_DEMO_DATA=true
# APP_BOOTSTRAP_DEMO_PASSWORD=<senha-do-admin-demo>
# Em produção atrás de proxy TLS, configurar a origem pública exata do BFF.
# BFF_PUBLIC_ORIGIN=https://governanca.example.com

# Configuração automática da equipe (somente desenvolvimento local):
# npm run setup:local -- --init-env .env.team.local
# O arquivo gerado inclui NODE_ENV=development, JWT novo e SETUP_MOCK_PASSWORD.
# Ajuste o usuário/senha do PostgreSQL e as portas nesse arquivo privado.
# Procedimento completo: docs/development/BANCO_E_IMPORTACAO_HISTORICA.md
